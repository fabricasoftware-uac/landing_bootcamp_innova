# ==============================================================================
# Supabase Configuration - Festival Cauca INNOVA 2026
# ==============================================================================

# URL base del proyecto Supabase (Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Llave anónima pública (segura para exponer en el navegador mediante prefijo NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Llave de rol de servicio (SECRETA: uso exclusivo en servidor / Server Actions / Admin scripts)
# NUNCA exponer en cliente ni prefijar con NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
