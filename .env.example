# ==============================================================================
# Supabase Configuration - Festival Cauca INNOVA 2026 (VPS FabSoft)
# ==============================================================================

# URL base del proyecto Supabase (Kong Gateway en VPS)
NEXT_PUBLIC_SUPABASE_URL=https://sbinnova.fabsoft.app

# Llave anónima pública (segura para exponer en el navegador mediante prefijo NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-jwt-token

# Llave de rol de servicio (SECRETA: uso exclusivo en servidor / Server Actions / Admin scripts)
# NUNCA exponer en cliente ni prefijar con NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt-token
