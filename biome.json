{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "app/**",
      "components/**",
      "lib/**",
      "tests/**",
      "*.json",
      "!package.json",
      "!pnpm-lock.yaml",
      "!.next",
      "!node_modules"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "useSemanticElements": "off",
        "noStaticElementInteractions": "off",
        "useValidAnchor": "off"
      },
      "performance": {
        "noImgElement": "off"
      },
      "style": {
        "noDescendingSpecificity": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      },
      "preset": "recommended"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
